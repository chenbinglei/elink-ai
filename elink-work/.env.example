# ================================
# ELink-AI 后端环境变量配置模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
#
# 文档版本：v2.1 | 更新日期：2026-06-05
# 位置：elink-work/.env.example（仅后端使用）
# 前端环境变量请使用 elink-web/.env.example
# 同步检查：每次修改 .env 后，须同步更新本文件
# ================================

# ==============================================================================
# 一、基础设施配置
# ==============================================================================

# ===== Nacos (配置中心 + 服务注册发现) =====
# NACOS_HOST: Nacos 服务器地址 (string, 默认: 127.0.0.1)
#   - Docker 部署时填写容器网络地址（如 172.20.0.x）
#   - 本地开发填写宿主机 IP
NACOS_HOST=your_nacos_host
# NACOS_PORT: Nacos 服务端口 (number, 默认: 8848)
NACOS_PORT=8848
# NACOS_USERNAME: Nacos 管理员用户名 (string, 默认: nacos)
#   - docker-compose 通过 ${NACOS_USERNAME:-nacos} 注入
NACOS_USERNAME=change_me
# NACOS_PASSWORD: Nacos 管理员密码 (string)
#   - docker-compose 通过 ${NACOS_PASSWORD:-nacos} 注入
#   - 生产环境必须使用强密码
NACOS_PASSWORD=change_me
# NACOS_NAMESPACE: Nacos 命名空间 (string, 默认: public)
NACOS_NAMESPACE=public

# ===== MySQL (关系型数据库) =====
# MYSQL_HOST: MySQL 服务器地址 (string, 默认: 127.0.0.1)
MYSQL_HOST=your_mysql_host
# MYSQL_PORT: MySQL 端口 (number, 默认: 3306)
MYSQL_PORT=3306
# MYSQL_USERNAME: MySQL 用户名 (string, 默认: root)
MYSQL_USERNAME=root
# MYSQL_PASSWORD: MySQL 密码 (string, 必填)
MYSQL_PASSWORD=your_mysql_password

# ===== Redis (缓存 + 会话存储) =====
# REDIS_HOST: Redis 服务器地址 (string, 默认: 127.0.0.1)
REDIS_HOST=your_redis_host
# REDIS_PORT: Redis 端口 (number, 默认: 6379)
REDIS_PORT=6379
# REDIS_PASSWORD: Redis 密码 (string)
#   - docker-compose 通过 ${REDIS_PASSWORD:-123456} 注入
REDIS_PASSWORD=your_redis_password

# ===== TDengine (时序数据库，data-service + crontab-service 使用) =====
# TDENGINE_HOST: TDengine 服务器地址 (string, 默认: 127.0.0.1)
TDENGINE_HOST=your_tdengine_host
# TDENGINE_PORT: TDengine 端口 (number, 默认: 6030)
TDENGINE_PORT=6030
# TDENGINE_USERNAME: TDengine 用户名 (string, 默认: root)
TDENGINE_USERNAME=root
# TDENGINE_PASSWORD: TDengine 密码 (string, 必填)
TDENGINE_PASSWORD=your_tdengine_password

# ==============================================================================
# 二、消息中间件配置
# ==============================================================================

# ===== EMQX MQTT Web Broker (设备通信) =====
# EMQX1_HOST: EMQX1 服务器地址 (string, 默认: 127.0.0.1)
#   - protocol-service 和 configure-service 的 web 通道
EMQX1_HOST=your_emqx1_host
# EMQX1_PORT: MQTT TCP 端口 (number, 默认: 1883)
EMQX1_PORT=1883
# EMQX1_USERNAME: MQTT 连接用户名 (string, 默认: admin)
EMQX1_USERNAME=admin
# EMQX1_PASSWORD: MQTT 连接密码 (string)
EMQX1_PASSWORD=your_emqx1_password

# ===== EMQX MQTT Inter Broker (内部通信) =====
# EMQX2_HOST: EMQX2 服务器地址 (string, 默认: 127.0.0.1)
#   - protocol-service 的内部通道
EMQX2_HOST=your_emqx2_host
# EMQX2_PORT: MQTT TCP 端口 (number, 默认: 2883)
EMQX2_PORT=2883
# EMQX2_USERNAME: MQTT 连接用户名 (string, 默认: admin)
EMQX2_USERNAME=admin
# EMQX2_PASSWORD: MQTT 连接密码 (string)
EMQX2_PASSWORD=your_emqx2_password

# ===== EMQX Dashboard Admin (docker-compose 容器管理) =====
# WARNING: 生产环境必须覆盖以下默认凭据
# docker-compose 通过 ${EMQX_ADMIN_USER:-admin} / ${EMQX_ADMIN_PASSWORD:-public} 注入
EMQX_ADMIN_USER=change_me
EMQX_ADMIN_PASSWORD=change_me

# ==============================================================================
# 三、云服务配置
# ==============================================================================

# ===== Aliyun OSS (对象存储，后端专用) =====
# ALIYUN_ACCESS_KEY_ID: 阿里云 AccessKey ID (string, 必填)
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
# ALIYUN_ACCESS_KEY_SECRET: 阿里云 AccessKey Secret (string, 必填)
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
# ALIYUN_OSS_BUCKET_NAME: OSS Bucket 名称 (string, 必填)
ALIYUN_OSS_BUCKET_NAME=your_bucket_name
# ALIYUN_OSS_ENDPOINT: OSS Endpoint (string, 默认: http://oss-cn-hangzhou.aliyuncs.com)
ALIYUN_OSS_ENDPOINT=http://oss-cn-hangzhou.aliyuncs.com

# ===== Aliyun SMS (短信服务，与 OSS 同一套主账号凭证) =====
# ALIYUN_SMS_ACCESS_KEY_ID: 短信服务 AccessKey ID (string, 必填)
ALIYUN_SMS_ACCESS_KEY_ID=your_sms_access_key_id
# ALIYUN_SMS_ACCESS_KEY_SECRET: 短信服务 AccessKey Secret (string, 必填)
ALIYUN_SMS_ACCESS_KEY_SECRET=your_sms_access_key_secret

# ==============================================================================
# 四、认证与安全配置
# ==============================================================================

# ===== Auth Service (认证服务) =====
# AUTH_HOST: 认证服务地址 (string, 默认: 127.0.0.1)
AUTH_HOST=your_auth_host
# AUTH_PORT: 认证服务端口 (number, 默认: 60001)
AUTH_PORT=60001

# ===== OAuth2 Client Secret (P1-T7 外置) =====
# OAUTH2_CLIENT_SECRET: OAuth2 客户端密钥 (string, 默认: sunos-client)
#   - 10 个业务服务 application.yml 中引用 ${OAUTH2_CLIENT_SECRET:sunos-client}
#   - 生产环境必须更换为强密钥
OAUTH2_CLIENT_SECRET=change_me
# OAUTH2_CLIENT_DERMS_SECRET: DERMS OAuth2 客户端密钥 (string, 默认: derms-client)
#   - together-service 专用 ${OAUTH2_CLIENT_DERMS_SECRET:derms-client}
OAUTH2_CLIENT_DERMS_SECRET=change_me

# ===== Gateway (API 网关) =====
# GATEWAY_USER: 网关管理用户名 (string, 默认: root)
GATEWAY_USER=root
# GATEWAY_PASSWORD: 网关管理密码 (string)
GATEWAY_PASSWORD=your_gateway_password

# ===== Configure Service Platform Keys (P1-T8 外置) =====
# 以下为 configure-service 与外部平台对接的加密密钥
# WARNING: 生产环境必须更换所有默认值
# PLATFORM_ID: 平台标识 (string, 默认: MACQKWDXI)
PLATFORM_ID=change_me
# PLATFORM_SECRET: 平台密钥 (string, 默认: JbhI7olOTAKs2ZNU)
PLATFORM_SECRET=change_me
# PLATFORM_DATA_SECRET: 数据加密密钥 (string, 默认: RVPxJ4aiZwMxnGri)
PLATFORM_DATA_SECRET=change_me
# PLATFORM_DATA_SECRET_IV: 数据加密 IV (string, 默认: kWKNeZyRYVCgYlX1)
PLATFORM_DATA_SECRET_IV=change_me
# PLATFORM_SIG_SECRET: 签名密钥 (string, 默认: WRfsTnyTI4r17b55)
PLATFORM_SIG_SECRET=change_me
# PLATFORM_INTERFLOW_URL: 互联平台 URL (string, URL)
PLATFORM_INTERFLOW_URL=your_platform_interflow_url

# ==============================================================================
# 五、业务功能配置
# ==============================================================================

# ===== Mail Client (邮件服务) =====
# MAIL_HOST: SMTP 服务器地址 (string, 默认: smtp.sina.com)
MAIL_HOST=your_smtp_host
# MAIL_PORT: SMTP 端口 (number, 默认: 465)
MAIL_PORT=465
# MAIL_USERNAME: 邮箱账号 (string)
MAIL_USERNAME=your_mail_username
# MAIL_CLIENT_SECRET: 邮箱客户端授权码 (string, 必填)
MAIL_CLIENT_SECRET=your_mail_client_secret

# ===== File Location (文件存储路径) =====
# FILE_PATH: 文件存储路径 (string, 默认: /opt/sunos/file)
FILE_PATH=/opt/sunos/file
# IMAGE_PATH: 图片存储路径 (string, 默认: /opt/sunos/image)
IMAGE_PATH=/opt/sunos/image

# ===== CORS Allowed Origins (跨域白名单) =====
# CORS_ALLOWED_ORIGINS: 允许跨域的前端域名白名单，多个域名用逗号分隔
#   格式: http(s)://domain:port
#   默认: http://localhost:9000,http://localhost:9001,http://localhost:9002
#   生产环境应替换为公网域名
CORS_ALLOWED_ORIGINS=http://localhost:9000,http://localhost:9001,http://localhost:9002

# ===== Wechatpay (微信支付) =====
# WECHATPAY_PAY_URL: 微信支付回调地址 (string, URL)
WECHATPAY_PAY_URL=your_wechatpay_pay_url
# WECHATPAY_REFUND_URL: 微信退款回调地址 (string, URL)
WECHATPAY_REFUND_URL=your_wechatpay_refund_url
# WECHATPAY_TRANSFER_URL: 微信转账回调地址 (string, URL)
WECHATPAY_TRANSFER_URL=your_wechatpay_transfer_url
