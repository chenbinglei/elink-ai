<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunmax.webapp.mapper.DictMapper">

  <select id="getDictByCode" parameterType="String" resultType="java.util.Map">
    SELECT
        t.id,
        t.dictcode,
        t.dict_section_code,
        t.dictname,
        t.dictvalue
    FROM
        b_dict t
    WHERE
        t.dict_section_code = #{dict_section_code}
  </select>
</mapper>