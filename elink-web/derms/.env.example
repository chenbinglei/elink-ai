# ================================
# derms 环境变量配置模板
# ================================
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
#
# .env.example 可提交到 Git（仅模板，不含敏感值）
# .env 不提交（含真实密钥，被 .gitignore 排除）
#
# 框架加载机制：
#   Vite 开发模式自动加载 .env（不再使用 .env.development）
#   .env.example 仅作模板，不被框架加载
#
# 新增变量时须同步更新 .env.example 和 .env

# 后端代理目标地址（本地开发时填写，生产环境通过 CI/CD 注入）
VITE_PROXY_TARGET=http://localhost:5000

# WebSocket 连接地址
VITE_WS_URL=ws://localhost:5000

# Mapbox 地图 Access Token（敏感值，在 .env 中填写实际值）
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token
