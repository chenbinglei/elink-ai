{
  "name": "@elink/shared",
  "version": "2.0.0",
  "private": true,
  "main": "src/index.js",
  "module": "src/index.js",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.js",
    "./auth": "./src/auth/index.js",
    "./http": "./src/http/index.js",
    "./utils": "./src/utils/index.js",
    "./utils/*": "./src/utils/*.js",
    "./auth/*": "./src/auth/*.js",
    "./http/*": "./src/http/*.js"
  },
  "peerDependencies": {
    "axios": ">=1.0.0",
    "js-cookie": ">=3.0.0",
    "qs": ">=6.0.0",
    "element-plus": ">=2.0.0"
  },
  "description": "Elink 前端公共模块（零运行时依赖，通过依赖注入解耦）"
}
