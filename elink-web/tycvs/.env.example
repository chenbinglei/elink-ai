# ================================
# tycvs 环境变量配置模板
# ================================
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
#
# .env.example 可提交到 Git（仅模板，不含敏感值）
# .env 不提交（含真实密钥，被 .gitignore 排除）
#
# 框架加载机制：
#   Vue CLI 开发模式自动加载 .env（不再使用 .env.development）
#   .env.example 仅作模板，不被框架加载
#
# 新增变量时须同步更新 .env.example 和 .env

# 后端代理目标地址（本地开发时填写，生产环境通过 CI/CD 注入）
VUE_APP_PROXY_TARGET=http://localhost:5000

# 后端API主机地址（生产环境fallback用）
VUE_APP_API_HOST=localhost:5000

# WebSocket 连接地址
VUE_APP_WS_URL=ws://localhost:5000

# 阿里云 OSS 配置（敏感值，在 .env 中填写实际值，用于 readOSSFile.js）
VUE_APP_OSS_BUCKET_NAME=your_oss_bucket_name
VUE_APP_OSS_REGION=oss-cn-hangzhou
VUE_APP_ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
VUE_APP_ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
